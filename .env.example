# Variable NAMES only — never commit real values. Copy to .env and fill in.
# The stocks pipeline reads these from the repo-root .env (stocks/lib/env.mjs); a missing
# key is reported as absent, never printed.

# Solana JSON-RPC endpoint used by the on-chain fetchers (an Alchemy/Helius URL).
SOLANA_RPC_URL=
# Key for the same Alchemy account, when the RPC URL is composed rather than pasted.
ALCHEMY_SOLANA_API_KEY=
# Optional CoinGecko Demo key for the quota-capped daily CEX-market rotation. It is not used for
# underlying-equity reference prices; those come from Pyth/Ondo/issuer sources.
COINGECKO_API_KEY=
# Pyth Hermes key — reference prices and publish times.
PYTH_API_KEY=
# Required by deploy-to-server.sh to purge rwasonar.com's Cloudflare cache after publication.
CF_ZONE_ID=
CF_API_KEY=
# The one shared Postgres database, `geodata` (local Docker over TCP; server: localhost).
# Only stocks/load-db.mjs needs it; it logs the host and database name, never the URL.
DATABASE_URL=
