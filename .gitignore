tmp
.DS_Store
.claude
node_modules/
package-lock.json
stocks/data/raw/

# Secrets live in .env; never commit them (the deploy script also refuses to copy it).
.env
.env.*
!.env.example

# npm install output
node_modules/

# Server-side job state (stocks/refresh-on-server.sh, stocks/watch-chain.mjs, PM2 logs)
logs/
.last-refresh-stats.json
.last-chain-watch-stats.json
.refresh.lock

# The per-token stock cards: generated per refresh by stocks/build-cards.mjs and rebuilt on the
# server, so they are never committed (441 HTML + 441 JSON files that change on every run).
cards/

# Reusable legal-template pages are generated alongside cards on every refresh. The machine-readable
# stocks-legal-templates.json catalogue remains tracked for initial deployments and API consumers.
templates/

# The API's own dependencies (api/package.json). The lockfile IS committed, so the deploy can
# `npm ci` the exact tree — the blanket package-lock.json rule above is un-ignored for it.
api/node_modules/
!api/package-lock.json

# Raw and normalised copies of every watched source, plus the watcher's per-URL state
# (stocks/watch-sources.mjs). Rebuilt by every run and pruned to the last five versions; the
# durable record is sonar.source_version in Postgres.
stocks/data/sources/
stocks/data/sources-state.json
