{
  "name": "rwa-sonar",
  "version": "1.0.0",
  "description": "RWA Sonar — how tokenized is it really",
  "main": "asset-modal.js",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest stocks && npm run test:api && npx jest stocks-page graph-page live-page monitor-page watch-page whatif-page asset-modal api-base",
    "test:api": "node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js api/test",
    "serve": "node dev-server.mjs",
    "stocks:universe": "node stocks/fetch-universe.mjs --run",
    "stocks:onchain": "node stocks/fetch-onchain.mjs --run",
    "stocks:sponsors": "node stocks/fetch-sponsor-apis.mjs --run",
    "stocks:prices": "node stocks/fetch-reference-prices.mjs --run",
    "stocks:venues": "node stocks/fetch-venues.mjs --run --only-dex",
    "stocks:meteora": "node stocks/fetch-meteora.mjs --run",
    "stocks:defi": "node stocks/fetch-defi-usage.mjs --run",
    "stocks:trades": "node stocks/fetch-recent-trades.mjs --run",
    "stocks:holders": "node stocks/fetch-holders.mjs --run",
    "stocks:afterhours": "node stocks/build-afterhours.mjs --run",
    "stocks:all": "npm run stocks:universe && npm run stocks:onchain && npm run stocks:sponsors && npm run stocks:prices",
    "stocks:build": "node stocks/build-stocks-db.mjs --run",
    "stocks:graph": "node stocks/build-graph.mjs --run",
    "stocks:health": "node stocks/build-health.mjs --run",
    "stocks:cards": "node stocks/build-cards.mjs --run",
    "stocks:snapshot": "node stocks/snapshot.mjs --run",
    "stocks:changes": "node stocks/build-changes.mjs --run",
    "stocks:db": "node stocks/load-db.mjs --run",
    "stocks:sources": "node stocks/extract-sources.mjs --run",
    "stocks:watch": "node stocks/watch-sources.mjs --run",
    "stocks:watch-chain": "node stocks/watch-chain.mjs --run",
    "stocks:sync": "node stocks/sync-assets-db.mjs",
    "stocks:test": "NODE_OPTIONS=--experimental-vm-modules npx jest stocks"
  },
  "devDependencies": {
    "jest": "^30.3.0"
  }
}
