{
  "name": "rwa-sonar",
  "license": "MIT",
  "version": "1.0.0",
  "description": "RWA Sonar — how tokenized is it really",
  "main": "asset-modal.js",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest --testPathPatterns='^stocks/' && npm run test:api && NODE_OPTIONS=--experimental-vm-modules npx jest stocks-page graph-page live-page monitor-page watch-page whatif-page landing-page methodology-page editorial-page review-page pitch-page economics-page asset-modal api-base script-globals hosting theme-tokens nav-menus motion motion-alive watch-page-links watch-delivery-ui powers-page tracking-page flows-page site-header theme",
    "test:api": "node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js api/test",
    "start": "node dev-server.mjs --with-api",
    "dev": "node dev-server.mjs --with-api",
    "serve": "node dev-server.mjs --static-only",
    "stocks:universe": "node stocks/fetch-universe.mjs --run",
    "stocks:onchain": "node stocks/fetch-onchain.mjs --run",
    "stocks:sponsors": "node stocks/fetch-sponsor-apis.mjs --run",
    "stocks:prices": "node stocks/fetch-reference-prices.mjs --run",
    "stocks:venues": "node stocks/fetch-venues.mjs --run --only-dex",
    "stocks:meteora": "node stocks/fetch-meteora.mjs --run",
    "stocks:defi": "node stocks/fetch-defi-usage.mjs --run",
    "stocks:trades": "node stocks/fetch-recent-trades.mjs --run",
    "stocks:holders": "node stocks/fetch-holders.mjs --run",
    "stocks:closed-market": "node stocks/build-closed-market.mjs --run",
    "stocks:lender-history": "node stocks/fetch-lender-price-history.mjs --run",
    "stocks:depth": "node stocks/fetch-solana-depth.mjs --run",
    "stocks:all": "npm run stocks:sponsors && npm run stocks:universe && npm run stocks:onchain && npm run stocks:mint-identities && npm run stocks:identity-onchain && npm run stocks:mint-identities && npm run stocks:prices",
    "stocks:build": "node stocks/build-stocks-db.mjs --run",
    "stocks:discovery-index": "node stocks/build-discovery-index.mjs --run",
    "stocks:comparisons": "node stocks/build-comparison-bundles.mjs --run",
    "stocks:graph": "node stocks/build-graph.mjs --run",
    "stocks:health": "node stocks/build-health.mjs --run",
    "stocks:legal-templates": "node stocks/build-legal-templates.mjs --run",
    "stocks:cards": "node stocks/build-cards.mjs --run",
    "stocks:protocol-dossiers": "node stocks/build-protocol-dossiers.mjs --run",
    "stocks:snapshot": "node stocks/snapshot.mjs --run",
    "stocks:changes": "node stocks/build-changes.mjs --run",
    "stocks:journal": "node stocks/build-change-journal.mjs --run",
    "stocks:defi-snapshot": "node stocks/snapshot-defi.mjs --run",
    "stocks:defi-changes": "node stocks/build-defi-changes.mjs --run",
    "stocks:collector-status": "node stocks/build-collector-status.mjs --run",
    "stocks:mint-identities": "node stocks/build-mint-identities.mjs --run",
    "stocks:identity-onchain": "node stocks/fetch-onchain.mjs --run --in=stocks/data/mint-identities.json --out=stocks/data/identity-onchain.json",
    "stocks:review-queue": "node stocks/build-review-queue.mjs --run",
    "stocks:review-ack": "node stocks/ack-review-event.mjs --run",
    "stocks:watchlist-changes": "node stocks/build-watchlist-changes.mjs --run",
    "stocks:db": "node stocks/load-db.mjs --run",
    "stocks:sources": "node stocks/extract-sources.mjs --run",
    "stocks:watch": "node stocks/watch-sources.mjs --run",
    "stocks:watch-chain": "node stocks/watch-chain.mjs --run",
    "stocks:watch-lending": "node stocks/watch-lending.mjs --run",
    "stocks:watch-caselaw": "node stocks/watch-caselaw.mjs --run",
    "stocks:sync": "node stocks/sync-assets-db.mjs",
    "stocks:test": "NODE_OPTIONS=--experimental-vm-modules npx jest --testPathPatterns='^stocks/'"
  },
  "devDependencies": {
    "jest": "^30.3.0"
  }
}
